DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
BLOB_STORE_ID=
# En Vercel, VERCEL_OIDC_TOKEN se inyecta automáticamente.
# En local, ejecuta `vercel env pull` para obtener las credenciales vigentes.
DATA_API_URL=

# Base DESECHABLE contra la que corren las pruebas de integración de Finanzas.
# No es la de desarrollo: cada caso siembra dentro de una transacción y termina
# en ROLLBACK, pero apuntarla a una base con datos reales sigue siendo mala idea.
# Sin ella, las suites que prueban los candados del control interno de efectivo
# no se ejecutan y `npm test` FALLA con instrucciones. Ver README, «Pruebas».
# Ejemplo: postgresql://postgres@127.0.0.1:5433/finanzas_test
DATABASE_URL_TEST=

# Escotilla para correr `npm test` sin base: no ejecuta las pruebas de los
# candados, sólo autoriza el salto de forma explícita y lo deja anunciado en la
# salida. Cualquier valor salvo 0/false/no. Úsala si sólo tocaste la UI.
# PERMITIR_PRUEBAS_SIN_BASE=1
